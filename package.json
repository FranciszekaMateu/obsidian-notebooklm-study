{
    "name": "obsidian-notebooklm-study",
    "version": "2.2.0",
    "description": "Study NotebookLM flashcards, quizzes and mind maps in Obsidian with FSRS spaced repetition.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "test": "esbuild tests/*.test.ts --bundle --platform=node --outdir=.test-build --log-level=warning && node --test .test-build/core.test.js .test-build/features.test.js"
    },
    "keywords": [
        "obsidian",
        "notebooklm",
        "flashcards",
        "spaced-repetition"
    ],
    "author": "FranciszekaMateu",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "20.19.9",
        "esbuild": "0.28.2",
        "obsidian": "1.13.1",
        "tslib": "2.8.1",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "ts-fsrs": "5.4.2"
    }
}
